# Copy to .env for local dev. On Vercel, set these as Environment Variables.

# --- Database ---
# Local dev: a plain SQLite file via the libSQL driver.
DATABASE_URL=file:./data/eurocup.sqlite
DATABASE_AUTH_TOKEN=
# Production (Turso):
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<from `turso db tokens create <db-name>`>

# --- Competition ---
# 11 = EuroCup (default), 10 = EuroLeague. One deployment + one DB per league.
LEAGUE_ID=11

# --- Dunkest API ---
# Bearer token for `npm run sync` and the /api/sync cron. If unset, the app
# reads it from the settings table instead (paste it on the /settings page).
# Get it: log into euroleaguefantasy.euroleaguebasketball.net, devtools console:
#   localStorage.getItem('flutter.authToken')
DUNKEST_TOKEN=

# --- Cron protection (Vercel) ---
# Set to any random string. Vercel Cron sends it as a Bearer token to /api/sync;
# without it, the GET endpoint is unauthenticated. Generate: `openssl rand -hex 32`
CRON_SECRET=
